default_platform(:ios)

APP_IDS = ["works.rainn.tilecam", "works.rainn.tilecam.watchkitapp"].freeze

# Xcode target name → its bundle identifier. Both targets are archived together
# (the watch app is embedded in the iOS app) and each needs its own App Store
# provisioning profile at archive time.
TARGET_APP_IDS = {
  "TileCam"      => "works.rainn.tilecam",
  "TileCamWatch" => "works.rainn.tilecam.watchkitapp"
}.freeze

RW_ASC_ENV = %w[RW_ASC_KEY_ID RW_ASC_ISSUER_ID RW_ASC_KEY_P8].freeze

def asc_api_key
  missing = RW_ASC_ENV.select { |name| ENV[name].to_s.strip.empty? }
  unless missing.empty?
    UI.user_error!("Missing #{missing.join(', ')}. On a Mac run lanes as " \
                   "`rw-apple exec -- bundle exec fastlane ios <lane>`. " \
                   "In CI set the RW_* secrets. See RainnWorks/apple-signing.")
  end
  app_store_connect_api_key(
    key_id: ENV.fetch("RW_ASC_KEY_ID"),
    issuer_id: ENV.fetch("RW_ASC_ISSUER_ID"),
    key_content: ENV.fetch("RW_ASC_KEY_P8"),
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  desc "Regenerate the Xcode project from project.yml (xcodegen is the source of truth)"
  lane :gen do
    sh("cd .. && xcodegen generate")
  end

  desc "Install the App Store certificate and profiles on this Mac with rw-apple (CI runs the sync step in the workflow)"
  lane :signing do
    sh("rw-apple", "sync", "tilecam")
  end

  desc "Build the App Store .ipa"
  lane :build do
    gen
    # In CI the runner has no signed-in Apple ID, so Xcode's automatic signing
    # can't mint profiles. The workflow's `rw-apple sync tilecam --ci` step
    # installed the App Store distribution cert + profiles; pin each archived
    # target to manual signing with them. (Local dev keeps automatic signing
    # from project.yml — this only runs in CI and edits the generated
    # .xcodeproj, never project.yml.)
    if is_ci
      TARGET_APP_IDS.each do |target, app_id|
        update_code_signing_settings(
          path: "TileCam.xcodeproj",
          use_automatic_signing: false,
          team_id: "53W966FBFP",
          code_sign_identity: "Apple Distribution",
          targets: [target],
          profile_name: "RW AppStore #{app_id}"
        )
      end
    end
    if is_ci
      # ASC rejects duplicate build numbers, but project.yml pins
      # CURRENT_PROJECT_VERSION to a constant. Use the monotonic GitHub run
      # number so every upload is unique — this also stays ahead of builds that
      # were uploaded but rejected in processing (which never show up in the API
      # yet still burn their build number on Apple's side).
      build_num = ENV["GITHUB_RUN_NUMBER"] ||
                  (latest_testflight_build_number(api_key: asc_api_key,
                                                  app_identifier: APP_IDS.first,
                                                  initial_build_number: 0) + 1).to_s
      increment_build_number(xcodeproj: "TileCam.xcodeproj", build_number: build_num)
      UI.message("CI build number set to #{build_num}")
    end
    build_app(
      project: "TileCam.xcodeproj",
      scheme: "TileCam",
      export_method: "app-store",
      output_directory: "build/fastlane",
      output_name: "TileCam.ipa",
      xcargs: is_ci ? nil : "-allowProvisioningUpdates"
    )
  end

  desc "Upload metadata + screenshots only (no binary, no submit)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,                       # skip the interactive HTML preview
      run_precheck_before_submit: false, # precheck needs extra scopes; skip
      submit_for_review: false
    )
  end

  desc "Build + upload binary + metadata + screenshots to App Store Connect (does NOT submit)"
  lane :release do
    build
    deliver(
      api_key: asc_api_key,
      ipa: "build/fastlane/TileCam.ipa",
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Build + upload to TestFlight"
  lane :beta do
    build
    upload_to_testflight(api_key: asc_api_key, skip_waiting_for_build_processing: true)
  end
end
